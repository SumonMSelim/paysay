# Copy to .env and fill in. Never commit your real .env.

# --- AWS / Amazon Bedrock (required for the agent to respond) ---
# The agent brain uses Amazon Bedrock first-party Nova models via the Converse
# API. Provide credentials with bedrock:InvokeModel permission for the model
# below, plus polly:SynthesizeSpeech if TTS is enabled.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials

# Bedrock model. Nova Pro by default; switch to us.amazon.nova-lite-v1:0 for
# lower cost. Some models require an inference profile id; verify with
#   aws bedrock list-inference-profiles --region $AWS_REGION
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=2048
# BEDROCK_TEMPERATURE=0.2       # optional; lower is more deterministic

# --- PayPal (optional) ---
# If PAYPAL_CLIENT_ID and PAYPAL_SECRET are provided, PaySay will automatically
# mint and refresh the OAuth2 access token on startup.
# Leave empty to run in demo mode with a simulated PayPal provider (no credentials needed).
# Get these from https://developer.paypal.com -> Apps & Credentials -> Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_MERCHANT_NAME=
PAYPAL_MERCHANT_EMAIL=

# --- App ---
PAYSAY_DEFAULT_LOCALE=en-US
PAYSAY_SUPPORTED_LOCALES=en-US,de-DE,th-TH
VOICE_TTS_ENABLED=true
SERVER_ADDR=:8080

# --- Daily collections check (optional) ---
# Shared secret the daily collections job presents to the internal endpoint
# (POST /api/internal/collections). Leave empty to disable the endpoint (404).
# Must be at least 16 characters when set. The same value must be given to the
# collections job (see jobs/collections and render.yaml).
COLLECTIONS_TOKEN=
